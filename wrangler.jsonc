{
  // Configuración de Cloudflare Workers Builds.
  //
  // Sin este archivo, `wrangler deploy` intenta averiguar sola qué desplegar,
  // se encuentra el workspace de pnpm con cinco paquetes y aborta:
  //
  //     ✘ [ERROR] The Cloudflare application detection logic has been run in
  //     the root of a workspace instead of targeting a specific project.
  //
  // El nombre TIENE que coincidir con el del Worker en el panel. Si no coincide,
  // wrangler no falla: crea otro Worker distinto con este nombre y lo despliega
  // ahí, con lo que el dominio se queda sirviendo el vacío y el build sale en
  // verde igualmente.
  "name": "panal",
  "compatibility_date": "2026-09-07",

  // El sitio es una SPA estática y Cloudflare sirve `dist/` sin pasar por código
  // nuestro, con UNA excepción: las fichas de los agentes. Esas pasan por
  // `worker/index.ts`, que les pone el título, la descripción y la imagen de
  // cada agente para que el enlace se vea al pegarlo en X, Telegram o Discord.
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",

    // Solo estas rutas pasan por el Worker; todo lo demás se sirve como antes,
    // sin invocarlo (y sin que cuente como petición del Worker). Con una lista
    // aquí, Cloudflare deja de mirar `Sec-Fetch-Mode` para decidirlo: manda lo
    // que diga la lista. Exige wrangler 4.20 o más nuevo.
    "run_worker_first": ["/agente/*"],

    // Cualquier ruta que no exista como archivo devuelve index.html con un 200,
    // que es lo que necesita react-router para que /agentes/lex cargue al
    // entrar directamente. Un 301/302 aplastaría todas las rutas contra `/` y
    // dejaría el sitemap sin sentido.
    //
    // Aquí estaba el fallback de Pages, en `public/_redirects`, con la linea
    // `/*  /index.html  200`. Hubo que BORRAR ese archivo: Workers no ignora
    // las reescrituras de `_redirects`, las rechaza, y tumba el despliegue con
    //
    //     Invalid _redirects configuration:
    //     Line 15: Infinite loop detected in this rule.
    //
    // Si algun dia se vuelve a Pages, hay que recrearlo — `not_found_handling`
    // es cosa solo de Workers. `public/_headers`, en cambio, vale en los dos,
    // pero NO en lo que responde el Worker: por eso `worker/cabeceras.ts`.
    "not_found_handling": "single-page-application"
  },

  // Los dominios ya enganchados en el panel. Van aqui porque `wrangler deploy`
  // SUSTITUYE la configuracion remota por esta: si no se declaran, el propio
  // despliegue los desengancha y el sitio se queda sin dominio.
  "routes": [
    { "pattern": "panal.lat", "custom_domain": true },
    { "pattern": "www.panal.lat", "custom_domain": true }
  ],

  // Por lo mismo: sin esto, el despliegue borra las variables puestas a mano en
  // el panel. Entre ellas VITE_WALLETCONNECT_PROJECT_ID, que se necesita EN EL
  // BUILD — se compila dentro del bundle. Al borrarla, el build siguiente sale
  // en verde y el sitio se publica sin poder conectar cartera desde el movil.
  "keep_vars": true,

  "observability": {
    "logs": {
      "enabled": true
    }
  },

  // test.panal.lat: una copia de la web para probar un cambio ANTES de
  // fusionarlo. Es OTRO Worker (`panal-test`), conectado al mismo repo en el
  // panel con `npx wrangler deploy --env test` como comando de despliegue, para
  // `main` y para las ramas: cada push a una rama la publica ahí (gana el
  // último) y al fusionar vuelve a quedar `main`. panal.lat no se entera.
  //
  // NO es pública: el dominio va detrás de Cloudflare Access (Zero Trust →
  // Access → Applications), que pide un correo de la lista antes de servir nada.
  // Habla con los contratos REALES de Monad: lo que se paga ahí es dinero de
  // verdad. Por eso la API la acepta como origen (`bot/src/net.ts`) y la app de
  // Panal NO la acepta como web que firma (`movil/src/lib/puente.ts`).
  //
  // Lo demás se hereda de arriba. Aquí van solo las dos cosas que TIENEN que ser
  // distintas: el nombre, para no desplegar encima de panal.lat, y los dominios,
  // porque un despliegue que declarase los de producción se los quitaría al
  // Worker `panal`.
  "env": {
    "test": {
      "name": "panal-test",
      "routes": [{ "pattern": "test.panal.lat", "custom_domain": true }]
    }
  }
}
