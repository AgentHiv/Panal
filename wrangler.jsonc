{
  // Configuración de Cloudflare Workers Builds.
  //
  // Sin este archivo, `wrangler deploy` intenta averiguar sola qué desplegar,
  // se encuentra el workspace de pnpm con cinco paquetes y aborta:
  //
  //     ✘ [ERROR] The Cloudflare application detection logic has been run in
  //     the root of a workspace instead of targeting a specific project.
  //
  // El nombre TIENE que coincidir con el del Worker en el panel. Si no coincide,
  // wrangler no falla: crea otro Worker distinto con este nombre y lo despliega
  // ahí, con lo que el dominio se queda sirviendo el vacío y el build sale en
  // verde igualmente.
  "name": "panal",
  "compatibility_date": "2026-09-07",

  // El sitio es una SPA estática: no hay código de servidor, así que no se
  // declara `main`. El Worker sirve `dist/` y nada más.
  "assets": {
    "directory": "./dist",

    // Cualquier ruta que no exista como archivo devuelve index.html con un 200,
    // que es lo que necesita react-router para que /agentes/lex cargue al
    // entrar directamente. Un 301/302 aplastaría todas las rutas contra `/` y
    // dejaría el sitemap sin sentido.
    //
    // Aquí estaba el fallback de Pages, en `public/_redirects`, con la linea
    // `/*  /index.html  200`. Hubo que BORRAR ese archivo: Workers no ignora
    // las reescrituras de `_redirects`, las rechaza, y tumba el despliegue con
    //
    //     Invalid _redirects configuration:
    //     Line 15: Infinite loop detected in this rule.
    //
    // Si algun dia se vuelve a Pages, hay que recrearlo — `not_found_handling`
    // es cosa solo de Workers. `public/_headers`, en cambio, vale en los dos.
    "not_found_handling": "single-page-application"
  },

  // Los dominios ya enganchados en el panel. Van aqui porque `wrangler deploy`
  // SUSTITUYE la configuracion remota por esta: si no se declaran, el propio
  // despliegue los desengancha y el sitio se queda sin dominio.
  "routes": [
    { "pattern": "panal.lat", "custom_domain": true },
    { "pattern": "www.panal.lat", "custom_domain": true }
  ],

  // Por lo mismo: sin esto, el despliegue borra las variables puestas a mano en
  // el panel. Entre ellas VITE_WALLETCONNECT_PROJECT_ID, que se necesita EN EL
  // BUILD — se compila dentro del bundle. Al borrarla, el build siguiente sale
  // en verde y el sitio se publica sin poder conectar cartera desde el movil.
  "keep_vars": true,

  "observability": {
    "logs": {
      "enabled": true
    }
  }
}
