<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12 y arriba dibuja la pantalla de arranque el sistema, y para eso lee
  ESTOS atributos del tema de la actividad —los de la plataforma, con prefijo
  `android:`— sin que la app tenga que llamar a nada. El icono va sobre un
  círculo que el sistema recorta, por eso se reutiliza el del lanzador, que ya
  está encajado en la zona segura.
-->
<resources>
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:windowSplashScreenBackground">@color/panal_paper</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>
