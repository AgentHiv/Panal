<?xml version="1.0" encoding="utf-8"?>
<!--
  El logo de Panal como vector: escala a cualquier densidad sin píxeles y pesa
  menos que un solo PNG. Los mipmap-*dpi siguen ahí para Android 7, que no
  entiende iconos adaptativos.

  Sale de public/logo.svg, con dos cambios deliberados: el perfil va en `ink`
  y no en el casi negro del original, porque sobre el fondo oscuro de la app
  aquel no se vería; y el conjunto se escala al 62 % del lienzo de 108, que es
  lo que el lanzador garantiza no recortar.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:pathData="M83.29,54.00L68.65,79.37L39.35,79.37L24.71,54.00L39.35,28.63L68.65,28.63Z"
        android:strokeColor="#F2EFFA"
        android:strokeWidth="3.66"
        android:strokeLineJoin="round" />
    <path
        android:pathData="M67.60,55.57L62.11,65.08L51.12,65.08L45.63,55.57L51.12,46.06L62.11,46.06Z"
        android:fillColor="#E29A2E" />
</vector>
