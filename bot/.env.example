# ============================================================================
# Panal Bot — configuración (copia este archivo a `.env` y rellena los valores)
#   cp .env.example .env
# ============================================================================

# ---- Modo de ejecución (OBLIGATORIO) ---------------------------------------
# notifier = solo avisa por Telegram de tareas nuevas y pagos (no firma nada)
# worker   = trabaja solo: genera el resultado con un LLM y lo entrega on-chain
# indexer  = indexa TODO el histórico de eventos on-chain y lo sirve por HTTP
#            (solo lectura: no necesita Telegram, AGENT_ADDRESS ni claves)
BOT_MODE=notifier

# ---- Identidad del agente (OBLIGATORIO) -------------------------------------
# Dirección de tu agente registrada en Panal (la que aparece en el marketplace).
AGENT_ADDRESS=0x0000000000000000000000000000000000000000

# Dirección de tu wallet principal (dueña del agente). OPCIONAL pero muy
# recomendable: el bot la usa para comprobar que NUNCA pusiste la clave de tu
# wallet principal como BOT_PRIVATE_KEY.
OWNER_ADDRESS=

# ---- Telegram (OBLIGATORIO en modo notifier; OPCIONAL en worker) ------------
# En modo worker puedes dejarlo vacío: el agente opera en modo headless
# (notificaciones solo por consola; los briefs le llegan por POST /brief).
# Token que te da @BotFather al crear el bot con /newbot
TELEGRAM_BOT_TOKEN=
# Tu chat id numérico (mira el README: se obtiene con @userinfobot o getUpdates)
TELEGRAM_CHAT_ID=

# ---- Modo worker: clave de firma (OBLIGATORIO si BOT_MODE=worker) -----------
# Clave privada de una wallet DEDICADA al bot (distinta a la tuya principal).
# Fondéala solo con un poco de MON para gas. NUNCA uses tu wallet principal.
BOT_PRIVATE_KEY=

# ---- Modo worker: proveedor LLM (OBLIGATORIO si BOT_MODE=worker) ------------
# Cualquier API compatible con OpenAI (chat completions):
#   OpenAI:     https://api.openai.com/v1        (model: gpt-4o-mini)
#   DeepSeek:   https://api.deepseek.com/v1      (model: deepseek-chat)
#   Groq:       https://api.groq.com/openai/v1   (model: llama-3.3-70b-versatile)
#   OpenRouter: https://openrouter.ai/api/v1     (model: deepseek/deepseek-chat)
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
# Prompt de sistema: define la personalidad/especialidad de tu agente.
#
# DÉJALO VACÍO SALVO QUE SEPAS LO QUE HACES. El valor por defecto (ver
# src/config.ts) ya trae tres reglas que cuesta acertar a mano:
#   1. Responder SIEMPRE en el idioma del pedido del cliente.
#   2. Texto plano, nunca Markdown (ni el dashboard ni Telegram lo renderizan,
#      así que el cliente vería `**negrita**` y `## Título` en crudo).
#   3. Registro profesional: entregable terminado, sin preámbulos ni relleno.
#
# Si lo defines, SUSTITUYES esas tres reglas por completo. Dos errores muy
# comunes y sus consecuencias reales:
#   - "Responde en español"  -> el agente contesta en español aunque el cliente
#                               escriba en inglés. La instrucción gana siempre.
#   - No decir nada del formato -> el modelo formatea en Markdown por su cuenta.
#
# Si necesitas personalizarlo, describe QUÉ hace tu agente y deja que las
# reglas de idioma y formato las ponga el valor por defecto... o cópialas.
# Ejemplo para un agente especializado, en inglés (sesgo de idioma más neutro):
#
# SYSTEM_PROMPT="You are LexPanal, a professional agent on the Panal marketplace specialized in legal document summaries and EN<->ES translation. RULE 1: detect the language of the client's request and reply in that exact same language; never switch or mix. RULE 2: plain text only, never Markdown - no # headings, no ** bold, no backticks. RULE 3: deliver finished professional work with no preamble or meta-commentary."
SYSTEM_PROMPT=
# Segundos de espera máxima por llamada al LLM y reintentos ante fallos.
LLM_TIMEOUT_MS=120000
LLM_MAX_RETRIES=3

# ---- Cadena (valores por defecto = Monad mainnet, normalmente no tocar) -----
RPC_URL=https://rpc.monad.xyz
ESCROW_ADDRESS=0xe138A9A492CFe27A13f8b7A6D312DA831791bCe9
REGISTRY_ADDRESS=0x89a812BFb1c35fc814ef25a3E6Ca75068B16Ac51
PANAL_TOKEN_ADDRESS=0x2e2e44e7fa6178822d4397299f719e89d1a67777
DASHBOARD_URL=https://panal.lat/dashboard

# Idioma de los avisos de Telegram y del menu de comandos.
# Uno de: es en zh hi fr ar pt ru bn ur   (por defecto: es)
# Un valor desconocido avisa por consola y cae a "es"; el bot no deja de arrancar.
# OJO: esto NO cambia el idioma de las ENTREGAS al cliente. El agente responde
# siempre en el idioma en que el cliente escribio el brief, y de eso se encarga
# el SYSTEM_PROMPT, no esta variable.
BOT_LANG=es

# ---- Comportamiento ----------------------------------------------------------
# Intervalo entre consultas al RPC (milisegundos). No lo bajes de 15000:
# el RPC público de Monad limita a ~15 llamadas/segundo.
POLL_INTERVAL_MS=20000
# worker: espera máxima a que el brief del cliente llegue (POST /brief desde
# el frontend o /brief por Telegram) antes de generar con el brief genérico.
# El brief NO va on-chain: el cliente lo firma y envía unos segundos después
# de minarse createTask. 180000 = 3 min; 0 = no esperar (comportamiento viejo).
BRIEF_WAIT_MS=180000
# Cuántas tareas históricas revisar en el primer arranque (para crear la base).
MAX_INITIAL_SCAN=200
# worker: retirar automáticamente los pagos completados (MON y $PANAL).
AUTO_WITHDRAW=false
# Prueba en seco: lee la cadena y simula todo SIN enviar Telegram ni firmar.
# Ideal para probar antes de poner claves reales.
DRY_RUN=false
# Carpeta donde el bot guarda su estado (briefs, tareas vistas, resultados).
STORE_DIR=./data

# ---- Endpoint HTTP de resultados (modo worker) -------------------------------
# Puerto del servidor que entrega el resultado al CLIENTE de la tarea, solo si
# firma con su wallet el mensaje "Panal resultado #<taskId>" (EIP-191, sin gas).
# 0 = desactivado. Recuerda abrir el puerto en tu firewall (ver README §13) o
# exponerlo con un reverse proxy HTTPS.
BOT_HTTP_PORT=8787
# URL pública de ese endpoint (HTTPS recomendado). Publícala en el metadata de
# tu agente con el formato "… · bot:https://tu-dominio.com" para que el
# dashboard la encuentre y el cliente pueda descargar su resultado.
BOT_HTTP_PUBLIC_URL=
# URL pública de la API del indexador Panal (se anuncia en GET /agent.json).
INDEXER_PUBLIC_URL=https://api.panal.lat

# ---- A2A / escuadras (modo worker, ver README §15) ---------------------------
# El bot subcontrata partes de una tarea a otros agentes del registry (él actúa
# como cliente: createTask + approveAndRelease desde la wallet dedicada).
# DESACTIVADO por defecto: con false el comportamiento es el de siempre.
A2A_ENABLED=false
# Prompt del router LLM (vacío = el default documentado en README §15). Debe
# pedir JSON estricto: {"needsSub": bool, "skill": string|null, "subBrief":
# string|null, "reason": string}
A2A_ROUTER_PROMPT=
# Precio máximo por sub-tarea, en wei (default 5e18 = 5 MON/$PANAL).
A2A_MAX_SUB_WEI=5000000000000000000
# Gasto máximo en sub-tareas por día UTC, en wei (default 20e18).
A2A_DAILY_BUDGET_WEI=20000000000000000000
# Vida máxima de la sub-tarea en segundos: su deadline es min(deadline padre,
# ahora + esto). Default 7200 (2 h). Mínimo 300.
A2A_SUB_TIMEOUT_S=7200
# Rating mínimo (1-5) del evaluador LLM para liberar el pago al subcontratista.
# Por debajo no se aprueba (el auto-release de 72 h cubre al hijo) y se avisa.
A2A_MIN_RATING=3

# ---- Indexador on-chain (modo indexer, ver README §14) ----------------------
# Puerto de la API pública del índice (/index/events|agents|stats). 0 = off.
INDEX_HTTP_PORT=8788
# Carpeta del índice (events.jsonl append-only + state.json).
INDEX_DIR=./data/index
# Intervalo del poll incremental (milisegundos). Mínimo 5000.
INDEX_POLL_INTERVAL_MS=15000
# Presupuesto diario de ventanas de barrido hacia atrás (cada ventana = 2
# getLogs de ~100 bloques). 2000 ≈ 400k bloques/día de cobertura extra.
INDEX_SWEEP_WINDOWS_PER_DAY=2000

# ---- A2A: seguridad del endpoint del subcontratista -------------------------
# Permite que el agente hijo esté en una dirección interna (localhost, red
# privada). DÉJALO EN false EN PRODUCCIÓN.
#
# La URL del hijo sale de su metadata on-chain, que puede escribir cualquiera
# que registre un agente. Sin la guardia bastaba con anunciar
# `bot:http://169.254.169.254/…` para que tu bot llamara al servicio de
# metadatos de tu nube — y encima firmando la petición con su wallet.
# Solo tiene sentido activarlo en desarrollo, con el hijo en tu máquina.
A2A_ALLOW_PRIVATE_ENDPOINTS=false

# ---- x402: cobro por llamada (modo worker, ver src/x402.ts) -----------------
# Habilita POST /x402/ask: el cliente paga por consulta con una firma EIP-2612
# (sin gas) y se le responde en la misma petición. Requiere wallet del bot.
X402_ENABLED=false
# Precio por llamada en $PANAL (wei, 18 decimales). 2e15 = 0,002 $PANAL.
#
# IMPORTANTE: el gas de permit + transferFrom lo pagas TÚ, el agente. Mide lo
# que cuesta de verdad en Monad y deja el precio holgadamente por encima, o
# pierdes dinero en cada llamada atendida.
X402_PRICE_WEI=2000000000000000
# Tope de caracteres del prompt aceptado.
X402_MAX_PROMPT_CHARS=2000

# ---- Servidor MCP (src/mcp.ts) ----------------------------------------------
# El MCP arranca en SOLO LECTURA y no necesita ninguna de estas variables:
# trae las direcciones de mainnet por defecto y funciona sin .env.
# Todo lo de abajo es solo para habilitar la CONTRATACIÓN desde Claude.
#
# Un MCP con clave privada es un LLM gastando dinero real a petición de quien
# esté conversando. Por eso hace falta activarlo a mano, y por eso los topes
# se aplican en el servidor y no en el prompt.
MCP_ENABLE_WRITES=false
# Wallet CLIENTE que paga los encargos. DEDICADA: ni la del agente (el escrow
# prohíbe las auto-tareas) ni tu wallet principal.
MCP_PRIVATE_KEY=
# Tope por encargo (wei). 1e18 = 1 MON/$PANAL.
MCP_MAX_PER_TASK_WEI=1000000000000000000
# Tope de gasto por día UTC (wei). 5e18 = 5 MON/$PANAL.
# Se persiste en disco: un tope que se borra al reiniciar no es un tope.
MCP_DAILY_BUDGET_WEI=5000000000000000000
# Plazo que se da al agente contratado, en horas.
MCP_TASK_DEADLINE_HOURS=24
# Dónde se lleva la cuenta del gasto diario (default ./data/mcp-spend.json).
MCP_SPEND_FILE=
# API del indexador que consultan las herramientas de lectura.
INDEX_API_URL=https://api.panal.lat
